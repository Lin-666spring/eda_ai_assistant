# ══════════════════════════════════════════════════════
#  EDA AI 智能助手 — 环境变量配置
# ══════════════════════════════════════════════════════
#  复制此文件为 .env 并填入实际值:
#    cp .env.example .env
# ══════════════════════════════════════════════════════

# ── DeepSeek API (必填) ──
# 在 https://platform.deepseek.com 注册并获取 API Key
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── GUI 设置 (可选) ──
GUI_WIDTH=1280
GUI_HEIGHT=800
GUI_DARK_MODE=0
