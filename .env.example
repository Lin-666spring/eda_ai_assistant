# ══════════════════════════════════════════════════════
#  EDA AI 智能助手 — 环境变量配置
# ══════════════════════════════════════════════════════
#  复制此文件为 .env 并填入实际值:
#    cp .env.example .env
# ══════════════════════════════════════════════════════

# ── LLM API 配置（必填）──
# 方式一：使用厂商预设（推荐）
#   可选: deepseek | openai | qwen | glm | moonshot | siliconflow
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here

# 方式二：手动指定 Base URL 和模型（可选，会覆盖预设）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-pro

# ── GUI 设置 (可选) ──
GUI_WIDTH=1280
GUI_HEIGHT=800
GUI_DARK_MODE=0
