          { "label": "打开 AI 助手面板", "command": "eda-ai.open-panel" },
          { "label": "分析当前 BOM", "command": "eda-ai.analyze-bom" },
          { "label": "BOM 健康检查", "command": "eda-ai.bom-health" }
        ]
      }
    ],
    "pcb": [
      {
        "label": "EDA AI 助手",
        "submenus": [
          { "label": "打开 AI 助手面板", "command": "eda-ai.open-panel" },
          { "label": "DRC 检查", "command": "eda-ai.drc-check" },
          { "label": "多智能体审查", "command": "eda-ai.multi-agent-review" }
        ]
      }
    ],
    "blank": [
      {
        "label": "EDA AI 助手",
        "submenus": [
          { "label": "打开 AI 助手面板", "command": "eda-ai.open-panel" },
          { "label": "关于 EDA AI", "command": "eda-ai.about" }
        ]
      }
    ]
  },
  "commands": {
    "eda-ai.open-panel": { "handler": "openPanel" },
    "eda-ai.analyze-bom": { "handler": "analyzeBom" },
    "eda-ai.bom-health": { "handler": "bomHealth" },
